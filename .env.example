# PostgreSQL (контейнер db)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Database (приложение)
DB_HOST=db
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=changeme

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_REDIRECT_URL=http://localhost:8002/auth.php
DOMAIN=localhost:8002

# Slack (основной webhook)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#updates_by_caps
SLACK_USERNAME=INFO_CAPS

# Доп. канал через Slack API proxy (опционально)
SLACK_VIETNAM_API_URL=
SLACK_VIETNAM_API_KEY=
SLACK_VIETNAM_CHANNEL=updates_by_caps
SLACK_VIETNAM_WORKSPACE=

# Внешний API caps
API_TOKEN=
API_URL=

# App
PHP_MODE=development
